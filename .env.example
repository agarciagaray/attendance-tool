# Copia este archivo a .env y ajústalo. Las líneas que empiezan con # se ignoran.

# Obligatorio en producción. Genera una clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# true solo en tu propio equipo; muestra detalles de error a cualquiera.
DEBUG=false

# Nombres de host en los que responde la aplicación, separados por coma.
ALLOWED_HOSTS=asistencia.ejemplo.com
# Necesario cuando se sirve por HTTPS detrás de un proxy, separado por coma y con esquema.
CSRF_TRUSTED_ORIGINS=https://asistencia.ejemplo.com
# true cuando los usuarios acceden por HTTPS (marca las cookies como seguras).
HTTPS=false

# Zona horaria de la empresa. Las horas se guardan en UTC y se muestran en esta zona.
TIME_ZONE=America/Bogota
# Hora (0-23) en la que cambia el día de asistencia. 0 = medianoche.
DAY_ROLLOVER_HOUR=0

# Déjalo vacío para usar SQLite (guardado en ./data, o en el volumen attendance_data en Docker).
# Para Postgres: postgres://USUARIO:CONTRASEÑA@HOST:5432/BASE_DE_DATOS
DATABASE_URL=

# Notificaciones por correo (opcional). Deja EMAIL_HOST vacío para no enviar correos.
# Usa los datos SMTP de tu proveedor de correo. Si tu proveedor entrega una
# clave API para SMTP, va en EMAIL_HOST_PASSWORD y EMAIL_HOST_USER es el
# usuario fijo que indique el proveedor (por ejemplo, "apikey").
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# El puerto 587 usa STARTTLS (predeterminado). Para el puerto 465 usa EMAIL_USE_SSL=true.
EMAIL_USE_SSL=false
# Dirección desde la que se envían los avisos. Debe ser una permitida por tu proveedor.
EMAIL_FROM=

# Solo para docker-compose.postgres.yml, que inicia su propio contenedor Postgres.
POSTGRES_PASSWORD=

# Solo Docker: crea la primera cuenta de administrador al iniciar si no existe ninguna.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
